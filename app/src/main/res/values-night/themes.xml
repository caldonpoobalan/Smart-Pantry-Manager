<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- dark app theme -->
    <style name="Theme.SmartPantryManager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- primary brand colors for dark mode -->
        <item name="colorPrimary">@color/heading_blue</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- secondary brand colors for dark mode -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- status bar color -->
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>
</resources>